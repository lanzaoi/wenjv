# Backend environment variables for personal knowledge base (Example)
# Rename this file to `backend.env` and place it in your config directory (e.g., ~/.config/inquisitive/)

# Dual Provider Settings (B0)
# EMBEDDING_PROVIDER can be "ollama", "openai", or other supported providers
EMBEDDING_PROVIDER="ollama"
# CHAT_PROVIDER can be "ollama", "openai", or other supported providers
CHAT_PROVIDER="ollama"

# If using a cloud provider, configure these:
EMBEDDING_API_BASE="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY="sk-your-embedding-key-here"

CHAT_API_BASE="https://api.deepseek.com"
CHAT_API_KEY="sk-your-chat-key-here"
CHAT_MODEL="deepseek-chat"

# For cloud demonstration (e.g. SiliconFlow/bge-m3), use:
# EMBEDDINGS_MODEL="bge-m3"
# EMBEDDINGS_DIMENSION=1024

# Existing Ollama and standard config
OLLAMA_HOST="http://0.0.0.0:11434"
EMBEDDINGS_MODEL="chroma/all-minilm-l6-v2-f32"
EMBEDDINGS_DIMENSION=384
