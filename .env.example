# Backend environment variables for personal knowledge base (Example)
# Rename this file to `backend.env` and place it in your config directory (e.g., ~/.config/inquisitive/)

# Dual Provider Settings (B0)
# EMBEDDING_PROVIDER can be "ollama", "openai", or other supported providers
EMBEDDING_PROVIDER="ollama"
# CHAT_PROVIDER can be "ollama", "openai", or other supported providers
CHAT_PROVIDER="ollama"

# If using a cloud provider, configure these:
EMBEDDING_API_BASE="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY="sk-your-embedding-key-here"

CHAT_API_BASE="https://api.deepseek.com"
CHAT_API_KEY="sk-your-chat-key-here"
CHAT_MODEL="deepseek-chat"

# For cloud demonstration (e.g. SiliconFlow/bge-m3), use:
# EMBEDDINGS_MODEL="bge-m3"
# EMBEDDINGS_DIMENSION=1024

# Existing Ollama and standard config
OLLAMA_HOST="http://0.0.0.0:11434"
EMBEDDINGS_MODEL="chroma/all-minilm-l6-v2-f32"
EMBEDDINGS_DIMENSION=384

# RAG Behavior
# Set to false to allow LLM to hallucinate or attempt answers when retrieval hits are empty
RAG_REFUSE_ON_EMPTY=true

# Hybrid Search Settings (Y2+)
# Requires backfilling via `python backend/worker/fts5_backfill.py` if FTS5 is enabled.
# When off, RAG relies purely on vector search (or LIKE fallback).
HYBRID_SEARCH_ENABLED=false
HYBRID_KEYWORD_BACKEND=fts5 # fts5 | like
HYBRID_VECTOR_MAX_DISTANCE=0.8
HYBRID_RRF_K=5
HYBRID_RRF_WEIGHT_VECTOR=1.0
HYBRID_RRF_WEIGHT_KEYWORD=1.0

# Search Acceleration
SEARCH_TIMING_ENABLED=false
SEARCH_PARALLEL_LEGS=true
SEARCH_FETCH_MULTIPLIER=1

# Advanced Search Features (1.4/1.5)
# Note: Enabling RERANK_ENABLED will significantly increase search latency due to API calls.
RERANK_ENABLED=false
# Fallback logic depends on existing OCR and Gemini config
IMAGE_INGEST_ENABLED=true
IMAGE_CAPTION_FALLBACK_ENABLED=true
