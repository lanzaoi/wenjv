# 问据 (Wenjv) TypeScript 服务端环境变量模板
# 默认会自动读取 $WENJV_BASE_DIR/backend.env（默认 ~/.config/wenjv/backend.env），也可以直接通过环境变量覆盖

HOST=0.0.0.0
PORT=8787
# 数据根目录（默认 ~/.config/wenjv，包含 wenjv.db、lance_db/、uploads/、wiki_vault/）
# WENJV_BASE_DIR=~/.config/wenjv
# 本地 ONNX 模型目录（默认自动探测 ../models）
# MODELS_DIR=/path/to/jolly-hawking/models

# JWT 密钥（与旧版 backend.env 的 SECRET_KEY 自动兼容；优先读取 JWT_SECRET）
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_SECRET

# 云端对话大模型配置（OpenAI 兼容协议，支持讯飞星火 MaaS / DeepSeek / SiliconFlow 等）
CHAT_PROVIDER=openai
CHAT_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
CHAT_MODEL=spark-x2.6
CHAT_API_KEY=

# 文本 Embedding 配置（默认使用本地 bge_m3_onnx；也可切换为远端 OpenAI 兼容接口）
EMBEDDING_PROVIDER=local
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDINGS_MODEL=BAAI/bge-m3

# 重排器配置（默认使用本地 bge_reranker_base ONNX）
RERANK_ENABLED=true
RERANK_PROVIDER=local_onnx
# RERANK_API_BASE=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_MAX_LENGTH=256
# RERANK_MICRO_BATCH_SIZE=4

# 本地 CPU OCR 与公式识别 Sidecar（PP-OCRv5 Mobile + Pix2Text）
OCR_ENABLED=true
OCR_SIDECAR_URL=http://127.0.0.1:8788
OCR_IMAGE_MODE=auto
OCR_TIMEOUT_MS=60000
OCR_MIN_CHARS=40
