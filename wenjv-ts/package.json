{
  "name": "wenjv-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "doctor": "bash scripts/doctor.sh",
    "spike": "pnpm --filter @wenjv/spikes run all",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "no-stubs": "bash scripts/no-stubs.sh",
    "reingest": "pnpm --filter @wenjv/server run reingest --",
    "test:e2e": "playwright test",
    "verify": "pnpm run no-stubs && pnpm run typecheck && pnpm run test",
    "verify:all": "bash scripts/verify-all.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "onnxruntime-node",
      "@node-rs/argon2",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
